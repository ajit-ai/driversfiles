<tiles-definitions>

	<!-- START: Base Templates -->
	<definition name="base.template" template="/WEB-INF/jsp/base.jsp" />
	<definition name="main.template" extends="base.template">
		<put-attribute name="body" value="/WEB-INF/jsp/main.jsp" />
		<put-attribute name="footer" value="/WEB-INF/jsp/footer.jsp" cascade="true" />
	</definition>
	<definition name="two_column.template" extends="main.template">
		<put-attribute name="content" value="/WEB-INF/jsp/two_column.jsp" cascade="true" />
	</definition>
	<definition name="print.template" extends="base.template">
		<put-attribute name="body" value="/WEB-INF/jsp/main_print.jsp" />
		<put-attribute name="footer" value="/WEB-INF/jsp/footer.jsp" cascade="true" />
	</definition>
	<!-- END: Base Templates -->

	<!-- START: Public Pages -->
	<definition name="public.template" extends="main.template">
		<put-attribute name="menu" value="/WEB-INF/jsp/public_menu.jsp" cascade="true" />
	</definition>
	<definition name="home.page" extends="public.template">
		<put-attribute name="title" value="home.title" />
		<put-attribute name="active_menu" value="home" />
		<put-attribute name="content" value="/WEB-INF/jsp/home.jsp" cascade="true" />
	</definition>
	<definition name="login.page" extends="public.template">
		<put-attribute name="title" value="login.title" />
