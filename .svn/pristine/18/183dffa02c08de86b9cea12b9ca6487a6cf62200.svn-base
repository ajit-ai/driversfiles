security.channel = any
security.https.port = 443
security.http.port = 8080
db.driver = org.postgresql.Driver
db.url = jdbc:postgresql://127.0.0.1:5432/driversfiles
db.username = driversfiles
db.password = driversfiles
db.maxActive = 25
db.batchSize = 1000

# Email Settings
mail.host = localhost
mail.port = 25
#mail.username = test@netradius.com
#mail.password = test
mail.recipient = test@driversfiles.com
mail.from = noreply@driversfiles.com

# Delay quartz startup (in seconds)
quartz.startupDelay = 10

# s m h dom mo dow yr

# FileStoreService Settings
external.file.store = /opt/driversfiles/