html, body {
	margin: 0;
	font-family: arial, verdana, sans-serif;
	font-size: 14px;
}
a {
	color: black;
	text-decoration: underline;
}
a:hover {
	color: #990000;
}
#wrapper {
	margin: 0 auto;
}
#left {
	float: left;
	width: 200px;
}
#right {
	float: left;
}
#header {
	background: url('../images/driversfiles_200x65.png') no-repeat;
	height: 70px;
	position: relative;
	border-bottom: 2px solid #990000;
}
#header-login {
	position: absolute;
	top: 8px;
	right: 0;
}
#header-login a {
	color: black;
	text-decoration: underline;
}
#header-menu {
	position: absolute;
	bottom: 0;
	left: 230px;
}
#header-menu ul {
	margin: 0;
	padding: 0 0 0 5px;
	list-style: none;
}
#header-menu li {
	float: left;
	padding-right: 8px;
}
#header-menu a {
	display: block;
	background-color: #f6e2a5;
	color:  #990000;
	font-weight: bold;
	text-decoration: none;
	padding: 3px 3px 3px 3px;
	border-top: 1px solid black;
	border-left: 1px solid black;
	border-right: 1px solid black;
}
#header-menu a:hover {
	background-color: #990000;
	color: #f6e2a5;
}
#header-menu a.active {
	background-color: #990000;
	color: #f6e2a5;
}
#secondary-menu {
	background-color: #f6e2a5;
}
#content {
	margin: 0 10px 0 10px;
	padding: 15px 0 15px 0;
	clear: both;
}
.two-col-wrapper {
	float: left;
	width: 100%;
}
.two-col-left {
	float: left;
	width: 250px;
	height: 100%;
	margin-left: -100%;
}
.two-col-right {
	margin-left: 275px;
}
.two-col-left ul {
	margin: 0;
	padding: 0 0 0 0;
	list-style: none;
}
.two-col-left li {
	padding: 3px 0 3px 0;
}
.two-col-left a {
	height: 16px;
	padding-left: 13px;
	display: block;
	text-decoration: none;
	color: #990000;
}
.two-col-left a.active {
	background: url('../images/arrow_8x15.png') no-repeat;
}
#footer {
	clear: both;
	text-align: center;
	font-size: 11px;
	padding-top: 3px;
	border-top: 2px solid #990000;
}
#footer a {
	color: #990000;
	text-decoration: none;
}
#footer a:hover {
	text-decoration: underline;
}
img {
	border: 0;
}
.clear {
	clear: both;
}
form {
	display: inline;
}
.searchform fieldset, .brform fieldset {
	padding: 10px 5px 10px 5px;
	border: 1px solid #990000;
	background: #fffcf2;
	margin-bottom: 10px;
}
.searchform label, .searchform input[type='text'], .brform label, .brform input[type='text'], .brform input[type='password'] {
	width: 250px;
	display: block;
	float: left;
	margin: 0 1px 8px 1px;
}
.searchform input[type='checkbox'], .brform input[type='checkbox'] {
	vertical-align: bottom;
	margin: 0;
}
.searchform input[type='file'], .brform input[type='file'] {
	width: 275px;
}
.searchform input[type='button'], .brform input[type='button'] {
	margin: 0 1px 8px 1px;
}
.searchform label, .brform label {
	text-align: right;
	padding-right: 20px;
	padding-top: 2px;
}
.searchform input[type='submit'], .brform input[type='submit'] {
	margin-right: 10px;
}
.searchform br, .brform br {
	clear: left;
}
.searchform div, .brform div {
	float: left;
	padding-top: 2px;
	margin: 0 1px 8px 1px;
}
.searchform label {
	width: 100px;
	white-space: nowrap;
}

.required {
	color: red;
}
.error {
	color: red;
}
.warning {
	color: orange;
}
.success {
	color: green;
}
#success {
	background-color: #eaffea;
	border: 2px solid green;
	color: #127412;
	padding: 3px 0 3px 10px;
	margin: 5px 0 5px 0;
}
#success div {
	background-image: url('../images/check_16x16.png');
	background-repeat: no-repeat;
	padding-left: 20px;
}

h1 { /* page header */
	border-bottom: 1px solid #990000;
	font-size: 16px;
	padding: 0;
	margin: 0 0 8px 0;
	color: #990000;
}
h1 a {
	display: block;
	float: right;
	font-size: 12px;
	font-weight: normal;
	text-decoration: underline;
	color: #990000;
	height: 16px;
	padding-top: 2px; /* attempt to middle align text with icon */
}
h1 a.add {
	padding-left: 20px;
	background: url('../images/add_16x16.png') no-repeat;
}
table.data {
	width: 100%;
	border-spacing: 0;
	/*border: 1px solid #dedede;*/
	border: 1px solid #990000;
	font-size: 12px;
}
table.data th {
	/*background: #f4f4f4;*/
	background: #f6e2a5;
	text-align: left;
	padding-left: 3px;
	/*color: #606060;*/
	color: #990000;
	/*border-bottom: 1px solid #dedede;*/
	border-bottom: 1px solid #990000;
}
table.data td {
	padding-left: 5px;
}
table.data tfoot td {
	/*background: #f4f4f4;*/
	background: #f6e2a5;
	text-align: right;
	/*color: #606060;*/
	color: #990000;
	/*border-top: 1px solid #dedede;*/
	border-top: 1px solid #990000;
	font-weight: bold;
	padding-left: 5px;
}
table.data a {
	text-decoration: none;
	color: #111c5a;
}
table.data a:hover {
	text-decoration: underline;
}
.highlight {
	background: #fffee5;
}
.odd-row {
	background: #f6f6f6;
	/*background: #fffcf2;*/
}
#application {
	background: none repeat scroll 0 0 #FFFCF2;
	border: 1px solid #990000;
	margin: auto;
	width: 650px;
	padding-bottom: 25px;
}
#application #discriminationDisclaimer {
	margin-top: 20px;
}
#application table {
	border-collapse: collapse;
	width: 100%;
}
#application .header1 {
	font-weight: bold;
	font-size: larger;
}
#application .nobr {
	white-space: nowrap;
}
#application .underline {
	border-bottom: 1px solid black;
}
#application .topMargin1 {
	margin-top: 20px;
}
#application .topMargin2 {
	margin-top: 10px;
}
#application .topPad1 {
	padding-top: 20px;
}
#application .topPad2 {
	padding-top: 10px;
}
#application .border1 {
	border: 1px solid black;
}
#application .companyName {
	font-weight: bold;
	text-decoration: underline;
}
#application .hint {
	font-size: smaller;
	font-style: italic;
}
#application .paddedData {
	padding-left: 10px;
}

@media print {
	#application {
		border: medium none;
		background-color: white;
	}
}