package com.driversfiles.www.core.dao;

import java.util.List;

import com.driversfiles.www.core.data.Driver;
import com.driversfiles.www.core.data.Traffic;

/**
 * Data access methods for Traffic data.
 *
 * @author Mark Burns
 */
public interface TrafficDao extends Dao<Traffic, Long> {

	/**
	 * Gets all Traffics for a driver
	 * 
	 * @param driver the Driver
	 * @return the list of Traffic instances
	 */
	List<Traffic> getTrafficRecords(Driver driver);

}
