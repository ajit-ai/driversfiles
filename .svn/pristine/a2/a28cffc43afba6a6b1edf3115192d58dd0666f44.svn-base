<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM
		"log4j.dtd">
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
	<appender name="console" class="org.apache.log4j.ConsoleAppender">
		<layout class="org.apache.log4j.PatternLayout">
			<!--<param name="ConversionPattern" value="%d %-5p [%c] %m%n" /> -->
			<param name="ConversionPattern" value="%d %-5p [%c:%L] %m%n" />
		</layout>
	</appender>
	<logger name="com.driversfiles.www">
		<level value="trace" />
	</logger>
	<!-- Log everything hibernate -->
	<logger name="org.hibernate">
		<level value="warn" />
	</logger>
	<!-- Log all SQL DML statements as they are executed -->
	<logger name="org.hibernate.SQL">
		<level value="warn" />
	</logger>
	<!-- Log all JDBC parameters -->
	<logger name="org.hibernate.type">
		<level value="warn" />
	</logger>
	<!-- Log all SQL DDL statements as they are executed -->
	<logger name="org.hibernate.tool.hbmddl">
		<level value="warn" />
	</logger>
	<!-- Log the state of all entities (max 20 entities) associated with the 
		session at flush time -->
	<logger name="org.hibernate.pretty">
		<level value="warn" />
	</logger>
	<!-- Log all second-level cache activity -->
	<logger name="org.hibernate.cache">
		<level value="warn" />
	</logger>
	<!-- Log transaction related activity -->
	<logger name="org.hibernate.transaction">
		<level value="warn" />
	</logger>
	<!-- Log all JDBC resource acquisition -->
	<logger name="org.hibernate.jdbc">
		<level value="warn" />
	</logger>
	<!-- Log HQL and SQL ASTs during query parsing -->
	<logger name="org.hibernate.hql.ast.AST">
		<level value="warn" />
	</logger>
	<!-- Log all JAAS authorization requests -->
	<logger name="org.hibernate.jaas">
		<level value="warn" />
	</logger>
	<logger name="org.quartz">
		<level value="trace" />
	</logger>
	<logger name="org.springframework">
		<level value="warn" />
	</logger>
	<root>
		<priority value="warn" />
		<appender-ref ref="console" />
	</root>
</log4j:configuration>
