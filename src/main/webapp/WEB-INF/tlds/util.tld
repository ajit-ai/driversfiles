<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
		version="2.0">
	<tlib-version>1.0</tlib-version>
	<short-name>util</short-name>
	<uri>util</uri>
	<function>
		<name>getStates</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			com.driversfiles.www.core.data.State[] getStates()
		</function-signature>
	</function>
	<function>
		<name>getCountries</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			com.driversfiles.www.core.data.Country[] getCountries()
		</function-signature>
	</function>
	<function>
		<name>getMonths</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			com.driversfiles.www.core.data.Month[] getMonths()
		</function-signature>
	</function>
	<function>
		<name>getYears</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			int[] getYears()
		</function-signature>
	</function>
	<function>
		<name>getPageLimits</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			int[] getPageLimits()
		</function-signature>
	</function>
	<function>
		<name>escapeJavascript</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			java.lang.String escapeJavascript(java.lang.String)
		</function-signature>
	</function>
	<function>
		<name>getContent</name>
		<function-class>com.driversfiles.www.jsp.TagUtil</function-class>
		<function-signature>
			java.lang.String getContent(java.lang.String)
		</function-signature>
	</function>
</taglib>
